<UserControl
    x:Class="sabores_wanka.Views.PuntoDeVenta.MesasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mesas="using:sabores_wanka.Views.PuntoDeVenta"
    mc:Ignorable="d">

    <!-- Mismo chrome que el grid de productos (replica Nachis): tarjeta glass,
         glow neon en press/hover y pills de estado. Datos: MesaItem en el .cs. -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="NachisTealBrush" Color="#00A3FF"/>
    </UserControl.Resources>

    <Grid>
        <Border Background="#111621" BorderBrush="#1f2638" BorderThickness="1,0,0,0">
            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Padding="16" BorderBrush="#1c2333" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="#142233" BorderBrush="#0090cb" BorderThickness="1">
                    <FontIcon Glyph="&#xE8A9;" FontSize="16" Foreground="#00c2ff" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="Plano y Selección de Mesas" Foreground="White" FontSize="13" FontWeight="Bold"/>
                    <TextBlock Text="Sede Huancayo • Salón Principal" Foreground="#64748b" FontSize="10"/>
                </StackPanel>
                <Button x:Name="AgregarSalaButton" Grid.Column="2" Background="#161c28" CornerRadius="10" Padding="12,6" BorderBrush="#334155" BorderThickness="1" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed" Click="AgregarSalaButton_Click">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="AgregarSalaTranslate"/>
                    </Button.RenderTransform>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE710;" FontSize="10" Foreground="#00c2ff"/>
                        <TextBlock Text="Agregar sala" Foreground="#00c2ff" FontSize="11" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ConfigButton" Grid.Column="3" Width="36" Height="36" Background="#161c28" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Click="ConfigButton_Click">
                    <FontIcon Glyph="&#xE713;" FontSize="14" Foreground="#94a3af" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Button>
            </Grid>

            <!-- Pills -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="16,12,16,8">
                <StackPanel x:Name="SalonesPanel" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="SalonPrincipalButton" Click="SalonButton_Click" Tag="Salón Principal" Background="#00a8e8" CornerRadius="12" Padding="14,6" BorderThickness="0"><TextBlock Text="Salón Principal (12)" Foreground="Black" FontSize="11" FontWeight="Bold"/></Button>
                    <Button x:Name="TerrazaButton" Click="SalonButton_Click" Tag="Terraza" Background="#161c28" BorderBrush="#232c3f" BorderThickness="1" CornerRadius="12" Padding="14,6"><TextBlock Text="Terraza (6)" Foreground="#cbd5e1" FontSize="11"/></Button>
                    <Button x:Name="BarraButton" Click="SalonButton_Click" Tag="Barra" Background="#161c28" BorderBrush="#232c3f" BorderThickness="1" CornerRadius="12" Padding="14,6"><TextBlock Text="Barra (4)" Foreground="#cbd5e1" FontSize="11"/></Button>
                    <Button x:Name="ParaLlevarButton" Click="SalonButton_Click" Tag="Para Llevar" Background="#161c28" BorderBrush="#232c3f" BorderThickness="1" CornerRadius="12" Padding="14,6"><TextBlock Text="Para Llevar" Foreground="#cbd5e1" FontSize="11"/></Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Leyenda -->
            <Grid Grid.Row="2" Padding="16,8" BorderBrush="#161c28" BorderThickness="0,0,0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="6"><Ellipse Width="8" Height="8" Fill="#94a3af"/><TextBlock Text="TODAS" Foreground="#cbd5e1" FontSize="10" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"><Ellipse Width="8" Height="8" Fill="#00e5ff"/><TextBlock Text="ESTA ORDEN" Foreground="#00e5ff" FontSize="10" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"><Ellipse Width="8" Height="8" Fill="#00c982"/><TextBlock Text="LIBRE" Foreground="#00c982" FontSize="10" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"><Ellipse Width="8" Height="8" Fill="#f43f5e"/><TextBlock Text="OCUPADA" Foreground="#f43f5e" FontSize="10" FontWeight="Bold"/></StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0"><Ellipse Width="8" Height="8" Fill="#eab308"/><TextBlock Text="RESERVADA" Foreground="#eab308" FontSize="10" FontWeight="Bold"/></StackPanel>
            </Grid>

            <!-- Grid mesas: mismo formato que el grid de productos (replica Nachis).
                 AgregarMesaCard arriba (solo config), GridView con glow + tarjeta
                 glass por mesa. Datos: MesaItem en el .cs. -->
            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Button x:Name="AgregarMesaCard" Background="#0c1017" BorderBrush="#232c3e" BorderThickness="1" CornerRadius="12" Padding="16" Margin="16,12,16,0" Visibility="Collapsed" Click="AgregarMesaCard_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                    <Button.RenderTransform>
                        <TranslateTransform x:Name="AgregarMesaTranslate"/>
                    </Button.RenderTransform>
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#161c28" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="#94a3af" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Agregar mesa" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Nueva mesa o barra" Foreground="#475569" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                    <GridView x:Name="MesaGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="MesaGrid_ItemClick">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <!-- Sin maximo de columnas: fluye a 2, 3 o 4 segun el ancho del carrito. -->
                                <ItemsWrapGrid Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                        <GridView.ItemContainerStyle>
                            <Style TargetType="GridViewItem">
                                <Setter Property="Margin" Value="0,0,6,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GridViewItem">
                                            <Grid x:Name="ItemRoot" RenderTransformOrigin="0.5,0.5">
                                                <Grid.RenderTransform>
                                                    <ScaleTransform x:Name="ItemScale" ScaleX="1" ScaleY="1"/>
                                                </Grid.RenderTransform>
                                                <Border x:Name="NeonGlowBorder" CornerRadius="18" Margin="-2" Opacity="0" BorderThickness="2" BorderBrush="{StaticResource NachisTealBrush}">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#00E5FF" Opacity="0.08"/>
                                                    </Border.Background>
                                                </Border>
                                                <Border x:Name="OuterGlowBorder" CornerRadius="20" Margin="-4" Opacity="0" BorderThickness="3" BorderBrush="#4000E5FF"/>
                                                <ContentPresenter x:Name="ContentRoot"/>
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="NeonGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="OuterGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="PointerOver">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1.02" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1.02" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="NeonGlowBorder" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="OuterGlowBorder" Storyboard.TargetProperty="Opacity" To="0.2" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Pressed">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="NeonGlowBorder" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.05"/>
                                                                <DoubleAnimation Storyboard.TargetName="OuterGlowBorder" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.05"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Selected">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="ItemScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="NeonGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="OuterGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                        <VisualState x:Name="Focused">
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="NeonGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                                <DoubleAnimation Storyboard.TargetName="OuterGlowBorder" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GridView.ItemContainerStyle>
                        <GridView.ItemTemplate>
                            <DataTemplate x:DataType="mesas:MesaItem">
                                <Grid Width="168" Margin="0,6,6,0">
                                    <Grid CornerRadius="16" Background="#14FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1,1,0,0" Padding="12">
                                        <StackPanel Spacing="2">
                                            <Grid>
                                                <TextBlock Text="{x:Bind Nombre}" Foreground="White" FontSize="13" FontWeight="Black" VerticalAlignment="Center"/>
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Padding="6,2" CornerRadius="4" Background="{x:Bind EstadoPillFondo, Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind Estado, Mode=OneWay}" Foreground="{x:Bind EstadoColor, Mode=OneWay}" FontSize="9" FontWeight="Black"/>
                                                </Border>
                                            </Grid>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{x:Bind CapacidadTexto}" Foreground="#64748B" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind EstadoTexto, Mode=OneWay}" Foreground="{x:Bind EstadoColor, Mode=OneWay}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                            <Grid Margin="0,6,0,0" BorderBrush="#161c28" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                                <TextBlock Text="{x:Bind Detalle, Mode=OneWay}" Foreground="#475569" FontSize="10" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="2" Visibility="{x:Bind ConfigVisible, Mode=OneWay}">
                                                    <Button Click="EditarMesaIcon_Click" Background="Transparent" BorderThickness="0" Padding="4">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="12" Foreground="#94a3af"/>
                                                    </Button>
                                                    <Button Click="EliminarMesaIcon_Click" Background="Transparent" BorderThickness="0" Padding="4">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="12" Foreground="#f43f5e"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <!-- Pin ESTA ORDEN flotando sobre el borde (no consume ancho de la fila). -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,10,0"
                                            Background="#E60F172A" CornerRadius="6" Padding="8,3"
                                            BorderBrush="#8000E5FF" BorderThickness="1" Canvas.ZIndex="10"
                                            Visibility="{x:Bind MarcaVisible, Mode=OneWay}">
                                        <TextBlock Text="ESTA ORDEN" Foreground="{StaticResource NachisTealBrush}" FontSize="8" FontWeight="Black"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </GridView.ItemTemplate>
                    </GridView>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="4" Background="#0d1118" Padding="16" BorderBrush="#1a202d" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="IrMesaButton" Click="IrMesaButton_Click" Background="#00a8e8" CornerRadius="12" Height="50" HorizontalAlignment="Stretch" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon x:Name="IrMesaIcon" Glyph="&#xE8A9;" FontSize="16" Foreground="Black"/>
                        <TextBlock x:Name="IrMesaTextBlock" Text="IR A LA MESA 08" Foreground="Black" FontSize="11" FontWeight="Black"/>
                    </StackPanel>
                </Button>
                <Button x:Name="CerrarButton" Click="CerrarButton_Click" Grid.Column="1" Background="#161c28" CornerRadius="12" Padding="20,14" BorderBrush="#334155" BorderThickness="1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cerrar" Foreground="#e2e8f0" FontSize="11" FontWeight="Bold"/>
                </Button>
            </Grid>
        </Grid>
        </Border>
        <!-- Diálogo Nueva sala -->
        <Grid x:Name="NuevaSalaDialog" Visibility="Collapsed" Background="#80000000">
            <Border Width="380" Background="#1e2632" CornerRadius="16" BorderBrush="#2d3a46" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Nueva sala" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="CerrarDialogButton" Click="CerrarDialogButton_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94a3af"/>
                        </Button>
                    </Grid>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nombre de la sala" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <Border Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="12">
                            <TextBox x:Name="NombreSalaTextBox" Text="Terraza" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" PlaceholderText="Ej: Terraza"/>
                        </Border>
                    </StackPanel>
                    <Button x:Name="CrearSalaButton" Click="CrearSalaButton_Click" Background="#0f1e33" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch" BorderBrush="#1e3a5f" BorderThickness="1" Margin="0,8,0,0">
                        <TextBlock Text="Crear sala" Foreground="#e0f2fe" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Diálogo Nueva mesa -->
        <Grid x:Name="NuevaMesaDialog" Visibility="Collapsed" Background="#80000000">
            <Border Width="380" Background="#1e2632" CornerRadius="16" BorderBrush="#2d3a46" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Nueva mesa" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="CerrarMesaDialogButton" Click="CerrarMesaDialogButton_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94a3af"/>
                        </Button>
                    </Grid>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nombre de la mesa" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <Border Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="12">
                            <TextBox x:Name="NombreMesaTextBox" Text="Mesa 09" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" PlaceholderText="Ej: Mesa 09"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Sala" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <ComboBox x:Name="SalaComboBox" PlaceholderText="Seleccionar sala" HorizontalAlignment="Stretch" Background="#0f172a" BorderBrush="#334155" Foreground="White">
                            <ComboBoxItem Content="Salón Principal"/>
                            <ComboBoxItem Content="Terraza"/>
                            <ComboBoxItem Content="Barra"/>
                            <ComboBoxItem Content="Para Llevar"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="CrearMesaButton" Click="CrearMesaButton_Click" Background="#0f1e33" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch" BorderBrush="#1e3a5f" BorderThickness="1" Margin="0,8,0,0">
                        <TextBlock Text="Crear mesa" Foreground="#e0f2fe" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Diálogo Editar mesa -->
        <Grid x:Name="EditarMesaDialog" Visibility="Collapsed" Background="#80000000">
            <Border Width="380" Background="#1e2632" CornerRadius="16" BorderBrush="#2d3a46" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Editar mesa" Foreground="White" FontSize="18" FontWeight="Bold"/>
                        <Button x:Name="CerrarEditarMesaButton" Click="CerrarEditarMesaButton_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94a3af"/>
                        </Button>
                    </Grid>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Nombre de la mesa" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <Border Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="12">
                            <TextBox x:Name="EditarNombreMesaTextBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" PlaceholderText="Ej: Mesa 09"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Sala" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <ComboBox x:Name="EditarSalaComboBox" PlaceholderText="Seleccionar sala" HorizontalAlignment="Stretch" Background="#0f172a" BorderBrush="#334155" Foreground="White">
                            <ComboBoxItem Content="Salón Principal"/>
                            <ComboBoxItem Content="Terraza"/>
                            <ComboBoxItem Content="Barra"/>
                            <ComboBoxItem Content="Para Llevar"/>
                        </ComboBox>
                    </StackPanel>
                    <Button x:Name="GuardarMesaButton" Click="GuardarMesaButton_Click" Background="#0f1e33" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch" BorderBrush="#1e3a5f" BorderThickness="1" Margin="0,8,0,0">
                        <TextBlock Text="Guardar cambios" Foreground="#e0f2fe" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Diálogo Confirmar eliminar -->
        <Grid x:Name="EliminarMesaConfirmDialog" Visibility="Collapsed" Background="#80000000">
            <Border Width="380" Background="#1e2632" CornerRadius="16" BorderBrush="#2d3a46" BorderThickness="1" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="¿Desea eliminar esta mesa?" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EliminarMesaNombreText" Text="Mesa 01" Foreground="#f43f5e" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Esta acción no se puede deshacer." Foreground="#94a3af" FontSize="11" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Click="CancelarEliminarButton_Click" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch">
                            <TextBlock Text="Cancelar" Foreground="#cbd5e1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>
                        <Button Grid.Column="1" Click="ConfirmarEliminarButton_Click" Background="#dc2626" CornerRadius="10" Padding="12" BorderThickness="0" HorizontalAlignment="Stretch">
                            <TextBlock Text="Eliminar" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Diálogo Abrir mesa (solo para mesas LIBRE) -->
        <Grid x:Name="AbrirMesaDialog" Visibility="Collapsed" Background="#B3000000">
            <Border Width="420" Background="#161C28" CornerRadius="16" BorderBrush="#2D3A46" BorderThickness="1" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <Grid>
                        <TextBlock x:Name="AbrirMesaTitleText" Text="Mesa 01" Foreground="White" FontSize="20" FontWeight="Bold"/>
                        <Button x:Name="CerrarAbrirMesaButton" Click="CerrarAbrirMesaButton_Click" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="4">
                            <FontIcon Glyph="&#xE711;" FontSize="13" Foreground="#94a3af"/>
                        </Button>
                    </Grid>

                    <!-- Empleado encargado -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Empleado encargado" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#64748b" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ComboBox x:Name="EmpleadoComboBox" PlaceholderText="Seleccionar empleado" HorizontalAlignment="Stretch" Background="#0f172a" BorderBrush="#334155" Foreground="White">
                            <ComboBoxItem Content="Lady Diana"/>
                            <ComboBoxItem Content="Erick Canah..."/>
                            <ComboBoxItem Content="Carlos M."/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Número de personas -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Número de personas" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="*" Foreground="#ef4444" FontSize="12"/>
                        </StackPanel>
                        <StackPanel x:Name="PersonasPanel" Orientation="Horizontal" Spacing="4">
                            <Button Click="PersonaPill_Click" Tag="1" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="1" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="2" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="2" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="3" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="3" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="4" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="4" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="5" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="5" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="6" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="6" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="7" Width="36" Height="34" CornerRadius="8" Background="#0f172a" BorderBrush="#334155" BorderThickness="1" Padding="0"><TextBlock Text="7" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                            <Button Click="PersonaPill_Click" Tag="Otro" Height="34" CornerRadius="8" Padding="12,0" Background="#0f172a" BorderBrush="#334155" BorderThickness="1"><TextBlock Text="Otro" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/></Button>
                        </StackPanel>
                        <TextBox x:Name="OtroPersonasTextBox" Visibility="Collapsed" Margin="0,6,0,0" Background="#0f172a" BorderBrush="#334155" Foreground="White" PlaceholderText="N.º de personas" InputScope="Number"/>
                    </StackPanel>

                    <!-- Comentario -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Comentario" Foreground="#cbd5e1" FontSize="12" FontWeight="SemiBold"/>
                        <Border Background="#0f172a" CornerRadius="10" BorderBrush="#334155" BorderThickness="1" Padding="10">
                            <TextBox x:Name="ComentarioTextBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" PlaceholderText="Agregar comentario..." AcceptsReturn="True" TextWrapping="Wrap" Height="90"/>
                        </Border>
                    </StackPanel>

                    <Button x:Name="ConfirmarAbrirMesaButton" Click="ConfirmarAbrirMesaButton_Click" Background="#00A8E8" CornerRadius="12" Padding="12" HorizontalAlignment="Stretch" BorderThickness="0" Margin="0,4,0,0">
                        <TextBlock Text="Abrir mesa" Foreground="Black" FontSize="14" FontWeight="Black" HorizontalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
