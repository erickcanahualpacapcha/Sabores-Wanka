                <Border Width="34" Height="34" CornerRadius="17" Background="#1F94A3B8" BorderBrush="#5594A3B8" BorderThickness="1">
                    <FontIcon Glyph="&#xE7BA;" FontSize="15" Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SIN MESA ACTIVA" Foreground="#8AA0BA" FontSize="9" FontWeight="Bold" CharacterSpacing="90"/>
