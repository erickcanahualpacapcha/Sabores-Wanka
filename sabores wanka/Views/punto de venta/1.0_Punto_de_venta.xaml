                                <Border Width="36" Height="36" CornerRadius="10" Background="#0F1F2A"><FontIcon Glyph="&#xE8C7;" FontSize="16" Foreground="#00C2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Configurar Pagos y Cuotas" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
