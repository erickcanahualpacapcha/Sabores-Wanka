                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                            <!-- Factura -->
                            <StackPanel x:Name="FacturaDatosPanel" Visibility="Collapsed" Spacing="8">
                                <TextBlock Text="Datos para Factura" Foreground="#F59E0B" FontSize="11" FontWeight="Bold"/>
