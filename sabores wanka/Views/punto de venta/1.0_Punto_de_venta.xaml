                        </StackPanel>
                    </Grid>
                    <Button x:Name="CerrarMesaButton" Click="CerrarMesaButton_Click" Grid.Row="1" Background="#0080ff" CornerRadius="12" Height="50" Margin="0,12,0,0" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon x:Name="CerrarMesaButtonIcon" Glyph="&#xE8C7;" FontSize="18" Foreground="White"/>
                            <TextBlock x:Name="CerrarMesaButtonText" Text="Cerrar Mesa" Foreground="White" FontSize="13" FontWeight="Black"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </Grid>
                <Grid x:Name="MesasRoot" Visibility="Collapsed">
                    <mesas:MesasView x:Name="MesasPanel"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Toast de mesa: feedback flotante glass que aparece y se desvanece (efecto fantasma) -->
