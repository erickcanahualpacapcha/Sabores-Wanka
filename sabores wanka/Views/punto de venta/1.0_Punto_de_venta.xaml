                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Row="1" ColumnSpacing="8" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Click="CerrarClienteDialog_Click" Background="#1A2332" BorderBrush="#2A3647" BorderThickness="1" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch"><TextBlock Text="Cancelar" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/></Button>
                            <Button x:Name="AceptarClienteButton" Click="AceptarClienteButton_Click" Grid.Column="1" Background="#14B8A6" CornerRadius="10" Padding="12" BorderThickness="0" HorizontalAlignment="Stretch" IsEnabled="False" Opacity="0.5"><TextBlock Text="Aceptar" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center"/></Button>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Diálogo Seleccionar Vendedor (tono oscuro ámbar, esencia similar) -->
        <Grid x:Name="SeleccionarVendedorDialog" Visibility="Collapsed" Background="#B3000000">
            <Border Width="480" MaxHeight="560" Background="#1A150F" CornerRadius="16" BorderBrush="#3D2E1A" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="20,16,12,12" BorderBrush="#3D2E1A" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#2A1F0A" BorderBrush="#5A3E1A" BorderThickness="1">
                            <FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="¿Quién atendió?" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Selecciona el vendedor" Foreground="#8A7A5A" FontSize="11"/>
                        </StackPanel>
                        <Button Grid.Column="2" Click="CerrarVendedorDialog_Click" Background="Transparent" BorderThickness="0" Padding="6" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94A3B8"/>
                        </Button>
                    </Grid>
                    <Border Grid.Row="1" Margin="16,12,16,0" Background="#0F0D09" CornerRadius="10" BorderBrush="#3D2E1A" BorderThickness="1" Padding="12,0" Height="40">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#8A7A5A" VerticalAlignment="Center"/>
                            <TextBox x:Name="VendedorBusquedaTextBox" Grid.Column="1" Margin="8,0,0,0" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="12" PlaceholderText="Buscar vendedor..." VerticalAlignment="Center" TextChanged="VendedorBusqueda_TextChanged"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0">
                        <StackPanel x:Name="VendedoresListPanel" Spacing="1"/>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Padding="16" ColumnSpacing="8" BorderBrush="#3D2E1A" BorderThickness="0,1,0,0" Background="#0F0D09">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Click="CerrarVendedorDialog_Click" Background="#1A2332" BorderBrush="#2A3647" BorderThickness="1" CornerRadius="10" Padding="12" HorizontalAlignment="Stretch"><TextBlock Text="Cancelar" Foreground="#CBD5E1" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center"/></Button>
                        <Button x:Name="AceptarVendedorButton" Click="AceptarVendedorButton_Click" Grid.Column="1" Background="#F59E0B" CornerRadius="10" Padding="12" BorderThickness="0" HorizontalAlignment="Stretch" IsEnabled="False" Opacity="0.5"><TextBlock Text="Aceptar" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center"/></Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
