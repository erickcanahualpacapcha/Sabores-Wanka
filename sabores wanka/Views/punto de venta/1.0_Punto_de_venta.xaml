                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Razón Social *" Foreground="#94A3B8" FontSize="11"/>
                                    <TextBox x:Name="FacturaRazonTextBox" PlaceholderText="Razón Social" Background="#0A1518" BorderBrush="#1A2E33" Foreground="White" TextChanged="ClienteDatos_TextChanged"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Dirección" Foreground="#94A3B8" FontSize="11"/>
