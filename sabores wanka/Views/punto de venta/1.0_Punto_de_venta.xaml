        <!-- Diálogo Seleccionar Cliente (comprobante arriba, clientes como segunda opción) -->
        <Grid x:Name="SeleccionarClienteDialog" Visibility="Collapsed" Background="#B3000000">
            <Border Width="520" MaxHeight="620" Background="#0F1A1E" CornerRadius="16" BorderBrush="#1A3A3E" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <!-- Header -->
                    <Grid Padding="20,16,12,12" BorderBrush="#1A2E33" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#0F2E2B" BorderBrush="#1A4D3E" BorderThickness="1">
                            <FontIcon Glyph="&#xE716;" FontSize="16" Foreground="#14B8A6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Seleccionar Cliente" Foreground="White" FontSize="15" FontWeight="Bold"/>
                            <TextBlock Text="Elige quién factura" Foreground="#5A6B7A" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Background="#161C24" BorderBrush="#2A3647" BorderThickness="1" CornerRadius="8" Padding="10,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8EE;" FontSize="12" Foreground="#94A3B8"/>
                                    <TextBlock Text="Exportar" Foreground="#CBD5E1" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="NuevoClienteButton" Click="NuevoClienteButton_Click" Background="#14B8A6" CornerRadius="8" Padding="12,6" BorderThickness="0">
                                <TextBlock Text="Nuevo Cliente" Foreground="White" FontSize="11" FontWeight="Bold"/>
                            </Button>
                            <Button Click="CerrarClienteDialog_Click" Background="Transparent" BorderThickness="0" Padding="6" Margin="4,0,0,0">
                                <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#94A3B8"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- Tipo de comprobante ARRIBA -->
                    <StackPanel x:Name="ComprobanteSelectorPanel" Grid.Row="1" Spacing="8" Margin="16,12,16,0">
