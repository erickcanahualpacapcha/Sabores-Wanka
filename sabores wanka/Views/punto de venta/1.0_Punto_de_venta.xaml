                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Background="#161C24" BorderBrush="#202C3A" BorderThickness="1" CornerRadius="12" Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE774;" FontSize="13" Foreground="#00C982"/>
                                <TextBlock Text="WhatsApp" Foreground="#e2e8f0" FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Background="#161C24" BorderBrush="#202C3A" BorderThickness="1" CornerRadius="12" Padding="10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
