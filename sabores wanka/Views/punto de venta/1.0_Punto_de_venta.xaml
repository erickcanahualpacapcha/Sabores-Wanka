                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" Margin="16,12,16,0" BorderBrush="#1A2E33" BorderThickness="0,0,0,1" Padding="0,0,0,8">
                            <Border BorderBrush="#14B8A6" BorderThickness="0,0,0,2" Padding="0,0,0,6"><TextBlock Text="Todos" Foreground="#14B8A6" FontSize="11" FontWeight="Bold"/></Border>
                            <TextBlock Text="Recientes" Foreground="#5A6B7A" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Favoritos" Foreground="#5A6B7A" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Archivados" Foreground="#5A6B7A" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Text="Historial" Foreground="#5A6B7A" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="8,8,8,0" MaxHeight="200">
                            <StackPanel x:Name="ClientesListPanel" Spacing="1"/>
                        </ScrollViewer>
