                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <TextBlock Text="S/" Foreground="#64748B" FontSize="16" FontWeight="Bold" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
