                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button x:Name="ComprobanteNotaButton" Tag="Nota" Click="Comprobante_Click" Background="#14B8A6" BorderBrush="#14B8A6" BorderThickness="1" CornerRadius="8" Padding="10,8"><TextBlock Text="Nota de Venta" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/></Button>
                            <Button x:Name="ComprobanteBoletaButton" Tag="Boleta" Click="Comprobante_Click" Grid.Column="1" Background="#0A1518" BorderBrush="#1A2E33" BorderThickness="1" CornerRadius="8" Padding="10,8"><TextBlock Text="Boleta" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/></Button>
                            <Button x:Name="ComprobanteFacturaButton" Tag="Factura" Click="Comprobante_Click" Grid.Column="2" Background="#0A1518" BorderBrush="#1A2E33" BorderThickness="1" CornerRadius="8" Padding="10,8"><TextBlock Text="Factura" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Center"/></Button>
                        </Grid>
                    </StackPanel>
                    <!-- Botón para mostrar clientes del sistema (segunda opción) -->
                    <Button x:Name="SeleccionarClienteSistemaButton" Click="SeleccionarClienteSistemaButton_Click" Grid.Row="2" Background="Transparent" BorderBrush="#1A2E33" BorderThickness="1" CornerRadius="8" Padding="12,8" HorizontalAlignment="Stretch" Margin="16,12,16,0" HorizontalContentAlignment="Stretch">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="#5A6B7A" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Seleccionar cliente del sistema" Foreground="#94A3B8" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <FontIcon x:Name="SeleccionarClienteSistemaChevron" Grid.Column="2" Glyph="&#xE70D;" FontSize="10" Foreground="#5A6B7A" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <!-- Panel colapsable con buscador, tabs y lista -->
                    <Grid x:Name="ClientesSistemaPanel" Grid.Row="3" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Margin="16,12,16,0" Background="#0A1518" CornerRadius="10" BorderBrush="#1A2E33" BorderThickness="1" Padding="12,0" Height="40">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="#5A6B7A" VerticalAlignment="Center"/>
