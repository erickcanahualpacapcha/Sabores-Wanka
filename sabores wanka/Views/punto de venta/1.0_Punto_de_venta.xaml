                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="10" Foreground="#475569" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="#161C24" CornerRadius="12" BorderBrush="#1E2736" BorderThickness="1" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="10" Background="#1A1A1A"><FontIcon Glyph="&#xE77B;" FontSize="16" Foreground="#94a3af" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Datos del Cliente" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Nota de Venta" Foreground="#64748B" FontSize="11"/>
