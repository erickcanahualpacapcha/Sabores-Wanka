<UserControl
    x:Class="sabores_wanka.Views.Components.BarraLateral"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SidebarBgBrush" Color="#1c3c48" Opacity="0.95"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="White"/>
        <SolidColorBrush x:Key="SidebarBorderBrush" Color="White" Opacity="0.1"/>

        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="StatusButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Zona de activación: borde izquierdo absoluto de la ventana -->
        <Rectangle x:Name="TriggerZone"
                   Width="15"
                   Fill="#01000000"
                   HorizontalAlignment="Left"
                   PointerEntered="TriggerZone_PointerEntered"
                   Canvas.ZIndex="101"/>

        <!-- Panel lateral completo (280px) -->
        <Border x:Name="SidebarPanel"
                Background="{StaticResource SidebarBgBrush}"
                Width="280"
                HorizontalAlignment="Left"
                BorderBrush="{StaticResource SidebarBorderBrush}"
                BorderThickness="0,0,1,0"
                Canvas.ZIndex="100"
                PointerExited="SidebarPanel_PointerExited"
                PointerEntered="SidebarPanel_PointerEntered">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SidebarTranslate" X="-280"/>
            </Border.RenderTransform>

            <Grid Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado: es botón, abre Información del Negocio -->
                <Button x:Name="NegocioButton"
                        Click="NegocioButton_Click"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Stretch"
                        Margin="4,8,4,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#3B82F6" CornerRadius="8" Width="36" Height="36">
                            <FontIcon Glyph="&#xE7AD;" Foreground="White" FontSize="18"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <TextBlock Text="Sabores Wanka" Style="{StaticResource SidebarHeaderStyle}"/>
                            <TextBlock Text="Principal" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Botones de estado -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16">
                    <!-- WhatsApp -->
                    <Button x:Name="WhatsappButton" Click="WhatsappButton_Click" Style="{StaticResource StatusButtonStyle}" Background="#1525D366" BorderBrush="#2025D366">
                        <Grid HorizontalAlignment="Stretch" Padding="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#25D366" CornerRadius="8" Width="32" Height="32">
                                <FontIcon Glyph="&#xE8BD;" Foreground="White" FontSize="14"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="WHATSAPP" FontSize="10" FontWeight="Bold" Foreground="#4ADE80"/>
                                <TextBlock Text="Online" FontSize="9" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Punto de venta -->
                    <Button x:Name="TerminalButton" Click="TerminalButton_Click" Style="{StaticResource StatusButtonStyle}" Background="#150EA5E9" BorderBrush="#200EA5E9">
                        <Grid HorizontalAlignment="Stretch" Padding="12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#0EA5E9" CornerRadius="8" Width="32" Height="32">
                                <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="14"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="PUNTO DE VENTA" FontSize="10" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock Text="Procesar venta" FontSize="9" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Navegación -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="2">
                        <Button x:Name="HistorialButton" Click="HistorialButton_Click" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE81C;" Foreground="#A1A1AA" FontSize="16"/>
                                <TextBlock Text="Historial" Foreground="#D4D4D8" FontSize="14"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="ProductosButton" Click="ProductosButton_Click" Style="{StaticResource NavItemStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon Glyph="&#xE7BF;" Foreground="#A1A1AA" FontSize="16"/>
                                <TextBlock Text="Productos" Foreground="#D4D4D8" FontSize="14"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Perfil -->
                <Border Grid.Row="3" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="36" Height="36" CornerRadius="18" Background="#3B82F6">
                            <FontIcon Glyph="&#xE77B;" Foreground="White" FontSize="16"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="Iniciar sesión" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Cuenta de usuario" FontSize="9" FontWeight="Bold" Foreground="#38BDF8"/>
                        </StackPanel>
                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0">
                            <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="#71717A"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
