<UserControl
    x:Class="sabores_wanka.Views.HistorialDeVentas.VentaEdicionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- Editar venta: replica del patron 2.0_gastos (overlay flotante oscuro). -->
    <!-- El lapiz del historial abre este formulario precargado; al guardar -->
    <!-- actualiza la boleta por ticket y vuelve al historial ya recargado. -->
    <Grid Background="#99000000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <Grid x:Name="ModalRaiz" MaxWidth="1048" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ModalDesplazar"/>
            </Grid.RenderTransform>
        <StackPanel Spacing="16" Padding="24">

            <!-- Tarjeta principal -->
            <Border Background="#181f24" BorderBrush="#242d35" BorderThickness="1" CornerRadius="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: titulo + ticket + estado + fecha (arrastrar mueve la ventana) -->
                    <Grid x:Name="ModalMover" Padding="20,16" Background="Transparent" BorderBrush="#242d35" BorderThickness="0,0,0,1" PointerPressed="ModalMover_PointerPressed" PointerMoved="ModalMover_PointerMoved" PointerReleased="ModalMover_PointerReleased" PointerCanceled="ModalMover_PointerReleased" PointerCaptureLost="ModalMover_PointerReleased">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Width="34" Height="34" CornerRadius="10" Background="#fb923c1a" BorderBrush="#fb923c4d" BorderThickness="1">
                                <FontIcon Glyph="&#xE70F;" FontSize="15" Foreground="#fb923c" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Editar venta" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Background="#242c33" CornerRadius="8" Padding="12,5">
                                <TextBlock x:Name="TicketBadgeText" Text="B001-0000000" Foreground="White" FontSize="11" FontWeight="Bold" FontFamily="Consolas"/>
                            </Border>
                            <Border x:Name="EstadoBadge" Background="#10b98133" CornerRadius="8" Padding="12,5">
                                <TextBlock x:Name="EstadoBadgeText" Text="PAGADO" Foreground="#10b981" FontSize="11" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#fb923c14" CornerRadius="10" BorderBrush="#fb923c33" BorderThickness="1" Padding="12,6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="#fb923c"/>
                                <TextBlock x:Name="FechaBadgeText" Text="Hoy" Foreground="#fb923c" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Cuerpo en 2 columnas -->
                    <Grid Grid.Row="1" Padding="20,16" ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Izquierda: datos -->
                        <StackPanel Spacing="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="CLIENTE" Foreground="#9ca3af" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="ClienteTextBox" Foreground="White" FontSize="12" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="8" Padding="12,9" PlaceholderText="Nombre del cliente"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="MOZO / VENDEDOR" Foreground="#9ca3af" FontSize="10" FontWeight="Bold"/>
                                <TextBox x:Name="MozoTextBox" Foreground="White" FontSize="12" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="8" Padding="12,9" PlaceholderText="Quien atendio"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="COMPROBANTE" Foreground="#9ca3af" FontSize="10" FontWeight="Bold"/>
                                <StackPanel x:Name="ComprobantePanel" Orientation="Horizontal" Spacing="8">
                                    <Button Tag="Nota" Click="Comprobante_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Nota" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Boleta" Click="Comprobante_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Boleta" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Factura" Click="Comprobante_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Factura" Foreground="#9ca3af" FontSize="12"/></Button>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="MÉTODO DE PAGO" Foreground="#9ca3af" FontSize="10" FontWeight="Bold"/>
                                <StackPanel x:Name="MetodoPanel" Orientation="Horizontal" Spacing="8">
                                    <Button Tag="Efectivo" Click="Metodo_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Efectivo" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Tarjeta" Click="Metodo_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Tarjeta" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Yape" Click="Metodo_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Yape" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Plin" Click="Metodo_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Plin" Foreground="#9ca3af" FontSize="12"/></Button>
                                    <Button Tag="Otros" Click="Metodo_Click" Background="#14181c" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="10" Padding="16,10" MinWidth="0" MinHeight="0"><TextBlock Text="Otros" Foreground="#9ca3af" FontSize="12"/></Button>
                                </StackPanel>
                                <TextBlock x:Name="MetodoAvisoText" Text="La deuda se cobra con el botón Cobrar, no aquí." Foreground="#fb923c" FontSize="10" Visibility="Collapsed"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Derecha: productos + total -->
                        <StackPanel Spacing="12" Grid.Column="1">
                            <TextBlock Text="PRODUCTOS DE LA BOLETA" Foreground="#9ca3af" FontSize="10" FontWeight="Bold"/>
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="ItemsPanel" Spacing="8"/>
                            </ScrollViewer>
                            <Border Background="#1b2329" BorderBrush="#2b3540" BorderThickness="1" CornerRadius="12" Padding="16">
                                <Grid>
                                    <TextBlock Text="TOTAL" Foreground="#9ca3af" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TotalText" Text="S/ 0.00" Foreground="White" FontSize="24" FontWeight="ExtraBold" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Padding="20,14" BorderBrush="#242d35" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button Click="DescartarButton_Click" Background="Transparent" BorderThickness="0" CornerRadius="8" Padding="14,7" MinWidth="0" MinHeight="0">
                                <TextBlock Text="Descartar" Foreground="#9ca3af" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <Button Click="GuardarButton_Click" Background="#fb923c" BorderThickness="0" CornerRadius="8" Padding="16,7" MinWidth="0" MinHeight="0">
                                <TextBlock Text="Guardar cambios" Foreground="#1c1005" FontSize="12" FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>
    </Grid>
</UserControl>
